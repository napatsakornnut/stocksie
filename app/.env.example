# Stocksie frontend environment (copy to .env.local for local overrides).
# All vars are client-exposed (NEXT_PUBLIC_*) because the UI runs in the browser.

# Surfpool local RPC (localnet). Start Surfpool in local mode, then point here.
# Surfpool default RPC: http://127.0.0.1:8899
NEXT_PUBLIC_RPC_ENDPOINT=http://127.0.0.1:8899

# Commitment level for reads/transactions (processed | confirmed | finalized).
NEXT_PUBLIC_RPC_COMMITMENT=confirmed

# Stocksie program id (must match Anchor.toml [programs.localnet] stocksie).
NEXT_PUBLIC_PROGRAM_ID=At2vd5Mqd9xcHRFAZin1VHb6upEsF1GCXoFG19UHsQoj

# ---------------------------------------------------------------------------
# AI agent (/agent page, plan 005) — server-side only, never NEXT_PUBLIC_*.
# Any OpenAI-compatible chat-completions endpoint works (OpenAI, Z.ai GLM,
# Together, a local Ollama with an /v1 path, ...).
# ---------------------------------------------------------------------------

# Required for the agent features; without it /api/ai answers 501.
AI_API_KEY=

# Override to point at a different OpenAI-compatible provider.
AI_BASE_URL=https://api.openai.com/v1
AI_VISION_MODEL=gpt-4o-mini
AI_TEXT_MODEL=gpt-4o-mini

# Fallback THB-per-SOL used for receipt -> SOL conversion when the live
# CoinGecko rate fetch fails (offline demo).
NEXT_PUBLIC_SOL_THB_FALLBACK=5600

# ---------------------------------------------------------------------------
# Reflex policy gate (/agent drafts, plan 006) — server-side only.
# The modelless local decision engine annotates drafts against the household
# rules corpus (corpus/household/*.md). Absent → no badges, flow unchanged.
# Run it:  RIIR_REFLEX_CORPUS=corpus/household reflex
# ---------------------------------------------------------------------------

REFLEX_URL=http://127.0.0.1:7331

# Starting confidence floor for a "covered by a household rule" verdict.
# Per the reflex docs this should be FITTED on a labeled slice (>=16 cases)
# before quoting any accuracy — 0.5 is only a sane cold-start default.
REFLEX_CONFIDENCE_FLOOR=0.5

# ---------------------------------------------------------------------------
# Devnet (judge-clickable demo) — comment out the localnet block above and
# uncomment these instead. See docs/DEPLOY_DEVNET.md for the full runbook.
# ---------------------------------------------------------------------------

# NEXT_PUBLIC_RPC_ENDPOINT=https://api.devnet.solana.com
# NEXT_PUBLIC_RPC_WS_ENDPOINT=wss://api.devnet.solana.com
